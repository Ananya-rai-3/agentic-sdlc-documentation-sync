# Copy to .env for reference, but Claude Code reads these from your OS environment,
# not from the .env file. On Windows: setx NAME "value", then restart the terminal.
# Never commit real values.

# GitHub MCP (repo scope only)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Atlassian MCP (Jira + Confluence) needs no secrets: sign in once with /mcp (OAuth).

# Pipeline behaviour is set in .claude/settings.json "env":
#   PIPELINE_MODE=gated|auto   PIPELINE_MAX_REWORK_LOOPS=2   PIPELINE_STATUS_FILE=docs/pipeline-status.md
